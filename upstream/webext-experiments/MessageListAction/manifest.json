{
  "manifest_version": 2,
  "name": "MessageListAction API prototype",
  "version": "0.1",
  "description": "Sample usage of the MessageListAction Experiment draft",
  "permissions": ["messagesRead", "tabs"],
  "applications": {
    "gecko": {
      "id": "MessageListAction@thunderbird.api.development",
      "strict_min_version": "153.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "experiment_apis": {
    "MessageListAction": {
      "schema": "experiments/MessageListAction/schema/message-list-action.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["MessageListAction"]],
        "script": "experiments/MessageListAction/parent/ext-message-list-action.js"
      }
    }
  }
}
